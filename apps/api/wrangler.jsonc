    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_N2_GbRyXvKmo7mCGmxn-JQ_Sy6fD33X"
  },
  "env": {
    "production": {
      "name": "inspection-api-production"
    }
  }
}
